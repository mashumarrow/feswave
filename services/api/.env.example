# Local development only. Change credentials for any shared deployment.
POSTGRES_USER=feswave
POSTGRES_PASSWORD=feswave_dev_password
POSTGRES_DB=feswave
POSTGRES_PORT=55432
DATABASE_URL=postgresql://feswave:feswave_dev_password@127.0.0.1:55432/feswave
