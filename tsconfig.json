{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmitOnError": true,
    "rootDir": "frontend",
    "outDir": "public",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["frontend/**/*.ts"]
}
